<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>RedChat.Wpf</RootNamespace>
    <AssemblyName>RedChat</AssemblyName>
    <!-- Identité de l'application (propriétés du fichier RedChat.exe, installateur, « Applications installées »).
         Version : 3 nombres majeur.mineur.correctif ; installer\build-installer.ps1 la lit ici. -->
    <Version>1.0.0</Version>
    <Product>RedChat</Product>
    <Description>Messagerie privée pair-à-pair sur réseau local</Description>
    <ApplicationIcon>Assets\redchat.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\background.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RedChat.Presentation\RedChat.Presentation.csproj" />
    <PackageReference Include="NAudio" Version="3.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.17" />
    <PackageReference Include="SIPSorcery.VP8" Version="10.0.17" />
  </ItemGroup>
</Project>

