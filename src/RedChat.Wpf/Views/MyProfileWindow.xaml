<Window x:Class="RedChat.Wpf.Views.MyProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mon profil — RedChat" Width="560" Height="720" MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#090D14" Foreground="#F5F7FB">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="MON PROFIL" Foreground="#4D86FF" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Tes informations publiques" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="Ton profil est enregistré sur cet appareil et partagé avec tes contacts lorsqu'une connexion sécurisée est établie." Foreground="#B8C2D1" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#171F2C" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PHOTO DE PROFIL" Foreground="#B8C2D1" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Width="92" Height="92" CornerRadius="46" Background="#1D2A3C" ClipToBounds="True" BorderBrush="#286BFF" BorderThickness="2">
                                <Grid>
                                    <TextBlock x:Name="AvatarInitials" Text="RC" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="AvatarPreview" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                <Button Content="Choisir une photo" Click="ChooseAvatar_Click" Padding="14,8" Margin="0,0,0,8"/>
                                <Button Content="Retirer la photo" Click="RemoveAvatar_Click" Padding="14,8"/>
                                <TextBlock Text="PNG ou JPEG — 512 Kio maximum" Foreground="#A7B1C2" FontSize="10" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="NOM PUBLIC" Foreground="#B8C2D1" FontSize="10" FontWeight="Bold"/>
                <TextBox x:Name="DisplayNameBox" MaxLength="40" Margin="0,7,0,14" Padding="12,10" Background="#171F2C" Foreground="White" BorderBrush="#303B4D"/>
                <TextBlock Text="STATUT" Foreground="#B8C2D1" FontSize="10" FontWeight="Bold"/>
                <TextBox x:Name="StatusBox" MaxLength="80" Margin="0,7,0,14" Padding="12,10" Background="#171F2C" Foreground="White" BorderBrush="#303B4D"/>
                <TextBlock Text="À PROPOS" Foreground="#B8C2D1" FontSize="10" FontWeight="Bold"/>
                <TextBox x:Name="AboutBox" MaxLength="280" Height="94" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,14" Padding="12,10" Background="#171F2C" Foreground="White" BorderBrush="#303B4D"/>
                <Border Background="#171F2C" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="IDENTIFIANT PUBLIC (PeerId)" Foreground="#B8C2D1" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="PeerIdText" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,8"/>
                        <Button Content="Copier le PeerId" HorizontalAlignment="Left" Click="CopyPeerId_Click" Padding="12,6"/>
                        <TextBlock Text="Le code de sécurité est propre à chaque paire de correspondants ; consulte-le depuis la fiche d'une conversation." Foreground="#A7B1C2" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FeedbackText" Foreground="#FF8296" TextWrapping="Wrap" Margin="0,4,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Click="Close_Click" Padding="18,9" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" Click="Save_Click" Padding="22,9" Background="#174EC8" Foreground="White" BorderBrush="#4D86FF" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
