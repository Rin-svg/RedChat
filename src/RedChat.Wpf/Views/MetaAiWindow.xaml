<Window x:Class="RedChat.Wpf.Views.MetaAiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant IA local — Llama 3.2 1B" Width="900" Height="740" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#0B1422" Foreground="#F2F6FD">
    <Window.Resources>
        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid x:Name="MessageRow" Margin="4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Avatar" Grid.Column="0" Width="32" Height="32" Margin="0,2,9,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="16"
                        Background="#263A55">
                    <TextBlock Text="{Binding AvatarLabel}" FontSize="11" FontWeight="Bold"
                               Foreground="#F2F6FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Bubble" Grid.Column="1" MaxWidth="650" Margin="0,0,45,0"
                        Padding="14,10" CornerRadius="4,16,16,16" Background="#18283D"
                        BorderBrush="#263A55" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding SenderLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8298" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="19" />
                        <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#93A2B8"
                                   HorizontalAlignment="Right" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Avatar" Property="Grid.Column" Value="2" />
                    <Setter TargetName="Avatar" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Avatar" Property="Margin" Value="9,2,0,0" />
                    <Setter TargetName="Avatar" Property="Background" Value="#8B1730" />
                    <Setter TargetName="Bubble" Property="Grid.Column" Value="1" />
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Margin" Value="45,0,0,0" />
                    <Setter TargetName="Bubble" Property="Background" Value="#76233A" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#A33652" />
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="16,4,16,16" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Bubble" Property="Background" Value="#57202B" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#8E3343" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C2B40" />
            <Setter Property="Foreground" Value="#F2F6FD" />
            <Setter Property="BorderBrush" Value="#34445F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#142238" />
            <Setter Property="Foreground" Value="#F2F6FD" />
            <Setter Property="BorderBrush" Value="#34445F" />
            <Setter Property="CaretBrush" Value="#F21D45" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#142238" BorderBrush="#263A55" BorderThickness="1"
                CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="#48243B"
                        BorderBrush="#8B1730" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="20" Foreground="#FF7890"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Assistant IA" FontSize="17" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Fill="#51D39A" VerticalAlignment="Center" />
                        <TextBlock Text="  Llama 3.2 1B · local avec Ollama"
                                   Foreground="#A5B2C7" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="Installation…" VerticalAlignment="Center"
                        Click="Setup_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0E1928" BorderBrush="#1E3047" BorderThickness="1"
                CornerRadius="14" Padding="10">
            <ListBox x:Name="MessagesList" ItemsSource="{Binding Messages}"
                     ItemTemplate="{StaticResource ChatMessageTemplate}" Background="Transparent"
                     BorderThickness="0" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Grid.Row="0" Foreground="#A5B2C7" FontSize="11"
                       TextWrapping="Wrap" Margin="5,0,5,7" />
            <Border Grid.Row="1" Background="#142238" BorderBrush="#34445F" BorderThickness="1"
                    CornerRadius="14" Padding="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                             MinHeight="48" MaxHeight="130" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             KeyDown="PromptBox_KeyDown"
                             ToolTip="Écris un message. Entrée pour envoyer, Maj+Entrée pour un retour à la ligne." />
                    <Button x:Name="SendButton" Grid.Column="1" Content="Envoyer  ↑"
                            Background="#F21D45" BorderBrush="#F21D45" FontWeight="Bold"
                            MinWidth="104" Margin="4" Click="Send_Click" />
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="Entrée pour envoyer · Maj+Entrée pour aller à la ligne"
                       Foreground="#71819A" FontSize="10" Margin="8,5,0,0" />
        </Grid>

        <Grid x:Name="SetupOverlay" Grid.RowSpan="3" Panel.ZIndex="5" Visibility="Collapsed"
              Background="#E6080D16">
            <Border Width="520" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#142238" BorderBrush="#465873" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Utiliser l’IA gratuitement en local" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="RedChat utilise Llama 3.2 1B, un modèle de Meta exécuté localement par Ollama. Aucun compte ni aucune clé API ne sont nécessaires. Les réponses utilisent les ressources de votre ordinateur."
                               Foreground="#A5B2C7" TextWrapping="Wrap" Margin="0,9,0,12" />
                    <TextBlock Text="1. Installe Ollama depuis https://ollama.com/download/windows&#x0a;2. Dans PowerShell, exécute : ollama run llama3.2:1b&#x0a;3. Attends la fin du téléchargement du modèle, puis reviens ici."
                               Foreground="#F2F6FD" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Ollama doit rester démarré pour discuter. L’assistant est local et distinct du service Meta AI en ligne."
                               Foreground="#FFB86B" TextWrapping="Wrap" FontSize="11" />
                    <Button Content="Fermer" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Background="#F21D45" BorderBrush="#F21D45" FontWeight="Bold"
                            Click="CloseSetup_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
