<Window x:Class="RedChat.Wpf.Views.StatusCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RedChat.Wpf"
        Title="RedChat — Statuts" Height="760" Width="800" MinHeight="600" MinWidth="360"
        WindowStartupLocation="CenterOwner" Background="#171717" Foreground="#F5F5F5">
    <Window.Resources>
        <local:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter"/>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="STATUTS" FontSize="22" FontWeight="Bold" Foreground="#F04444"/>
            <TextBlock Text="Partagez une pensée avec vos contacts. Chaque statut expire après 24 heures." Foreground="#C8C8C8" Margin="0,5,0,14" TextWrapping="Wrap"/>
        </StackPanel>
        <Border x:Name="PublishPanel" Grid.Row="1" Background="#242424" BorderBrush="#454545" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Publier un statut texte" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="StatusTextBox" MinHeight="76" MaxLength="700" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#303030" Foreground="White" BorderBrush="#666666" Padding="9" />
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="Choisir une photo / vidéo" Padding="12,7" Background="#383838" Foreground="White" BorderBrush="#666666" Click="ChooseMedia_Click"/>
                    <Button Content="Retirer le média" Padding="12,7" Margin="8,0,0,0" Background="#383838" Foreground="White" BorderBrush="#666666" Click="ClearMedia_Click"/>
                    <TextBlock x:Name="SelectedMediaLabel" Text="Aucun média sélectionné" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="Confidentialité du statut" FontWeight="SemiBold" Margin="0,12,0,5"/>
                <ComboBox x:Name="AudienceModeBox" SelectedIndex="0"
                          Background="#FFFFFF" Foreground="#222222"
                          BorderBrush="#777777" Padding="6">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#222222"/>
                            <Setter Property="Padding" Value="6,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="ItemText" Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemSurface" Property="Background" Value="#DCEBFF"/>
                                                <Setter TargetName="ItemText" Property="Foreground" Value="#172B4D"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemSurface" Property="Background" Value="#DCEBFF"/>
                                                <Setter TargetName="ItemText" Property="Foreground" Value="#172B4D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#DCEBFF"/>
                                    <Setter Property="Foreground" Value="#172B4D"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DCEBFF"/>
                                    <Setter Property="Foreground" Value="#172B4D"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#888888"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="Tous mes contacts"/>
                    <ComboBoxItem Content="Mes contacts sauf…"/>
                    <ComboBoxItem Content="Partager uniquement avec…"/>
                </ComboBox>
                <TextBlock Text="Pour les deux dernières options, sélectionne les contacts concernés (Ctrl + clic pour plusieurs)." Foreground="#C8C8C8" FontSize="11" Margin="0,5,0,4"/>
                <ListBox x:Name="AudienceList" Height="76" SelectionMode="Extended" Background="#303030" Foreground="White" BorderBrush="#666666" DisplayMemberPath="DisplayLabel"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <TextBlock x:Name="AudienceLabel" Text="L'envoi est limité aux contacts autorisés actuellement connectés." Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                    <Button x:Name="PublishButton" Content="Publier" Padding="18,7" Background="#C62828" Foreground="White" BorderThickness="0" Click="Publish_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel x:Name="LocalStatusesPanel">
                <TextBlock Text="Mes statuts sur cet appareil" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ListBox x:Name="StatusesList" Height="145" Background="#202020" Foreground="#F5F5F5" BorderBrush="#454545" Padding="5">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#454545" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding ContentLabel}" Foreground="#F04444" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding MediaLabel}" Foreground="#C8C8C8" FontSize="11" Margin="0,4,0,0"/>
                                <Image Source="{Binding MediaBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                       MaxWidth="420" MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,7,0,0">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MediaBytes}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding ExpiresLabel}" Foreground="#AAAAAA" FontSize="11" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ViewCountLabel}" Foreground="#C8C8C8" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Supprimer mon statut sélectionné pour tous" Padding="10,6" Margin="0,6,0,0" HorizontalAlignment="Right" Background="#7F1D1D" Foreground="White" BorderThickness="0" Click="DeleteStatus_Click"/>
            </StackPanel>
            <StackPanel x:Name="ReceivedStatusesPanel" Grid.Row="1" Margin="0,8,0,0">
                <TextBlock x:Name="ReceivedStatusesHeader" Text="Statuts reçus de mes contacts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="EmptyReceivedNotice" Text="Aucun statut reçu de ce contact pour le moment. Vérifie que le contact est connecté et qu'il a partagé le statut avec toi." Foreground="#B8B8B8" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="Collapsed"/>
                <Grid x:Name="StatusViewer" Height="570" Background="#080808" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,12,12,8">
                        <Grid x:Name="ProgressSegmentsPanel"/>
                        <DockPanel Margin="0,12,0,0">
                            <Button Content="×" DockPanel.Dock="Right" FontSize="22" Padding="8,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="CloseViewer_Click"/>
                            <StackPanel>
                                <TextBlock x:Name="ViewerSender" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ViewerTime" Foreground="#BBBBBB" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Image x:Name="ViewerImage" Source="{Binding MediaBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="Uniform" Margin="18,8"/>
                        <MediaElement x:Name="ViewerVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                      MediaOpened="ViewerVideo_MediaOpened" MediaEnded="ViewerVideo_MediaEnded" MediaFailed="ViewerVideo_MediaFailed"
                                      Visibility="Collapsed"/>
                        <Button Content="‹" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="58" FontSize="34" Background="#33000000" Foreground="White" BorderThickness="0" Click="PreviousStatus_Click"/>
                        <Button Content="›" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="58" FontSize="34" Background="#33000000" Foreground="White" BorderThickness="0" Click="NextStatus_Click"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#B8000000" Padding="14,12">
                        <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" FontSize="15" MaxHeight="90"/>
                    </Border>
                </Grid>
                <ListBox x:Name="ReceivedStatusesList" Height="Auto" MinHeight="175" MaxHeight="460" Background="#202020" Foreground="#F5F5F5" BorderBrush="#454545" Padding="5" SelectionChanged="ReceivedStatusesList_SelectionChanged">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#454545" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding SenderName}" Foreground="#F04444" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding ContentLabel}" Foreground="#C8C8C8" FontSize="11" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding MediaSizeLabel}" Foreground="#C8C8C8" FontSize="11" Margin="0,3,0,0"/>
                                <Image Source="{Binding MediaBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                       MaxWidth="620" MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MediaBytes}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ContentLabel}" Value="Vidéo reçue">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="Aperçu vidéo non disponible dans cette fenêtre." Foreground="#C8C8C8" FontSize="11" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContentLabel}" Value="Vidéo reçue">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ExpiresLabel}" Foreground="#AAAAAA" FontSize="11" Margin="0,5,0,0"/>
                                <TextBlock Text="Sélectionner ce statut envoie un reçu de consultation à son auteur." Foreground="#888888" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="FooterNotice" Grid.Row="3" Text="Les statuts sont transmis sur les connexions chiffrées aux contacts autorisés déjà connectés. Les contacts hors ligne ne reçoivent pas encore de rattrapage automatique." Foreground="#E0A0A0" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"/>
    </Grid>
</Window>
