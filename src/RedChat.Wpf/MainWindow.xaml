<Window x:Class="RedChat.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:local="clr-namespace:RedChat.Wpf"
        Title="RedChat" Width="1540" Height="960" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen" Closing="OnClosing"
        Background="{StaticResource AppBackground}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#17263A" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#54739B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxWidth" Value="280" />
            <Setter Property="TextElement.Foreground" Value="#F4F6FA" />
        </Style>
        <LinearGradientBrush x:Key="ShellGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#111722" Offset="0" />
            <GradientStop Color="#090D14" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#141B27" Offset="0" />
            <GradientStop Color="#0A0E15" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4968" Offset="0" />
            <GradientStop Color="#A90E2C" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A7B1C2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailSurface" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RailSurface" Property="Background" Value="#263A55" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RailSurface" Property="Background" Value="#7F1025" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="#1C2B40" />
            <Setter Property="BorderBrush" Value="#263A55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F4F6FA" />
        </Style>
        <!-- Boutons d'appel : glyphes Segoe Fluent Icons (Windows 11) avec repli sur Segoe MDL2 Assets (Windows 10), mêmes points de code.
             États micro coupé / caméra en pause / raccrocher indiqués par la couleur, pas par le seul glyphe. -->
        <Style x:Key="CallIconButton" TargetType="Button" BasedOn="{StaticResource RoundActionButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="CallMicrophoneButton" TargetType="Button" BasedOn="{StaticResource CallIconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Call.IsMicrophoneMuted}" Value="True">
                    <Setter Property="Background" Value="#7A1620" />
                    <Setter Property="BorderBrush" Value="#FF4968" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CallCameraButton" TargetType="Button" BasedOn="{StaticResource CallIconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Call.IsCameraPaused}" Value="True">
                    <Setter Property="Background" Value="#7A1620" />
                    <Setter Property="BorderBrush" Value="#FF4968" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CallHangupButton" TargetType="Button" BasedOn="{StaticResource CallIconButton}">
            <Setter Property="Background" Value="#A90E2C" />
            <Setter Property="BorderBrush" Value="#FF4968" />
        </Style>
        <Style x:Key="SmallTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1C2B40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B8C2D1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MessageActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="#142238" />
            <Setter Property="BorderBrush" Value="#263A55" />
        </Style>
    </Window.Resources>

    <Grid x:Name="MainLayoutGrid" Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="326" MinWidth="285" />
            <ColumnDefinition Width="*" MinWidth="430" />
            <ColumnDefinition x:Name="DetailsColumn" Width="0" MinWidth="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Fond hommage : collage de référence assombri pour préserver le contraste des conversations. -->
        <Image Source="/RedChat;component/Assets/background.png" Stretch="UniformToFill" Opacity="0.72" IsHitTestVisible="False" Grid.RowSpan="2" Grid.ColumnSpan="4" />
        <Border Background="#66000000" IsHitTestVisible="False" Grid.RowSpan="2" Grid.ColumnSpan="4" CornerRadius="18" />

        <!-- Barre supérieure et marque RedChat -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#D90A0D14" BorderBrush="#263A55" BorderThickness="1" CornerRadius="18,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="326" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="258" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="42" Height="34" Stretch="Uniform" Margin="0,0,9,0">
                        <Canvas Width="52" Height="34">
                            <!-- Emblème original inspiré du petit chapeau rouge fourni -->
                            <Path Fill="#F21D45" Data="M 7,23 C 10,12 20,5 32,6 C 39,7 44,12 46,18 C 39,16 31,17 24,20 C 17,23 12,25 7,23 Z" />
                            <Path Fill="#FF7890" Data="M 4,24 C 12,25 19,22 26,19 C 34,16 42,16 49,19 C 45,24 35,27 25,28 C 15,29 7,28 4,24 Z" />
                            <Path Fill="#A90E2C" Data="M 8,29 C 19,31 35,29 45,25 C 41,31 27,34 15,32 C 12,32 9,31 8,29 Z" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RedChat" FontSize="20" FontWeight="Bold" Foreground="#F5F7FB" />
                        <TextBlock Text="MESSAGERIE PRIVÉE  ·  LAN P2P" FontSize="8.5" FontWeight="SemiBold" Foreground="#9AA7BA" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="#C90B1422" BorderBrush="#334259" BorderThickness="1" CornerRadius="14" Padding="13,7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="#55D6A5" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="Réseau local sécurisé" Foreground="#B8C2D1" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  Chiffrement de bout en bout" Foreground="#A7B1C2" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Style="{StaticResource RailButton}" Content="♧" ToolTip="Notifications" Click="Notifications_Click" automation:AutomationProperties.AutomationId="NotificationsButton" />
                    <Button Style="{StaticResource RailButton}" Content="⚙" ToolTip="Paramètres et données locales" Click="Settings_Click" automation:AutomationProperties.AutomationId="SettingsButton" />
                    <Button Content="Quitter" Style="{StaticResource PrimaryButton}" Padding="15,6" Margin="10,0,0,0" Click="Exit_Click" automation:AutomationProperties.AutomationId="ExitButton" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rail de navigation -->
        <Border Grid.Row="1" Grid.Column="0" Background="#85070A10" BorderBrush="#263A55" BorderThickness="1,0,0,1" CornerRadius="0,0,0,9">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource RailButton}" Content="⌂" ToolTip="Accueil — discussions" Click="ShowChats_Click" automation:AutomationProperties.AutomationId="HomeButton" />
                    <Button Style="{StaticResource RailButton}" Content="☆" ToolTip="Afficher les favoris" Click="ShowFavorites_Click" automation:AutomationProperties.AutomationId="FavoritesButton" />
                    <Border Width="34" Height="2" Background="#263A55" Margin="0,10" />
                    <Border Background="#48243B" CornerRadius="15" Width="46" Height="46" Margin="0,2">
                        <TextBlock Text="▤" Foreground="#FF7890" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Style="{StaticResource RailButton}" Content="☻" ToolTip="Contacts" Click="ShowFriends_Click" />
                    <Button Style="{StaticResource RailButton}" Content="◉" ToolTip="Statuts — espace de publication" Click="ShowStatuses_Click" automation:AutomationProperties.AutomationId="StatusesButton" />
                    <Button Style="{StaticResource RailButton}" Content="♙" ToolTip="Mon profil" Click="ShowMyProfile_Click" automation:AutomationProperties.AutomationId="MyProfileButton" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Button Style="{StaticResource RailButton}" Content="ⓘ" ToolTip="À propos" Click="About_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Liste des conversations -->
        <Border Grid.Row="1" Grid.Column="1" Background="#C90B1422" BorderBrush="#263A55" BorderThickness="0,0,1,1" Padding="17,19,15,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="VOTRE ESPACE" FontSize="10.5" FontWeight="Bold" Foreground="#8EA3C2" Margin="2,0,0,12" />
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="ChatsTab" Grid.Column="0" Content="DISCUSSIONS" Style="{StaticResource SmallTabButton}" Background="#F21D45" Foreground="White" Click="ShowChats_Click" automation:AutomationProperties.AutomationId="ChatsTab" />
                    <Button x:Name="FriendsTab" Grid.Column="1" Content="AMIS" Style="{StaticResource SmallTabButton}" Click="ShowFriends_Click" automation:AutomationProperties.AutomationId="FriendsTab" />
                </Grid>
                <Border Grid.Row="2" Background="#B50A0D14" BorderBrush="#263A55" BorderThickness="1" CornerRadius="13" Padding="12,2" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock Text="⌕" FontSize="21" Foreground="#7890B2" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBox x:Name="SearchBox" TextChanged="ConversationSearch_TextChanged" Background="Transparent" BorderThickness="0" Padding="0,8" FontSize="11" Foreground="#E3E8F0" ToolTip="Rechercher une discussion" automation:AutomationProperties.AutomationId="ConversationSearch" />
                    </DockPanel>
                </Border>
                <DockPanel Grid.Row="3" Margin="1,0,1,8">
                    <TextBlock x:Name="ListHeading" Text="VOS CONVERSATIONS" Foreground="#9AA7BA" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OpenContactButton" Content="Ouvrir" Padding="9,3" Margin="0,0,5,0" FontSize="9" Click="OpenSelectedContact_Click" IsEnabled="False" Visibility="Collapsed" />
                        <Button x:Name="CreateGroupButton" Content="＋" Width="27" Height="25" Padding="0" Margin="0" Click="CreateGroup_Click" ToolTip="Créer un groupe" automation:AutomationProperties.AutomationId="CreateGroupButton" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="4">
                    <ListBox x:Name="ConversationList" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}" SelectionChanged="ConversationList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         automation:AutomationProperties.AutomationId="ConversationList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#39243D"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#F21D45"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,0,0,0"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#39243D"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Width="38" Height="38" VerticalAlignment="Center" MouseLeftButtonUp="ContactAvatar_Click">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Cursor" Value="Arrow"/><Setter Property="ToolTip" Value="Aucun statut disponible"/><Style.Triggers><DataTrigger Binding="{Binding HasReceivedStatus}" Value="True"><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="Voir les statuts de ce contact"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Border CornerRadius="19" Background="#263D5B" BorderBrush="#42658F" BorderThickness="1">
                                        <TextBlock Text="{Binding AvatarInitials}" FontSize="11" FontWeight="Bold" Foreground="#E6EEF9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding RemoteAvatarBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding RemoteAvatarBytes}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill">
                                        <Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip>
                                        <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding AvatarPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                    </Image>
                                    <Border CornerRadius="21" BorderBrush="#55D6A5" BorderThickness="2" Margin="-2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasReceivedStatus}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,4,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#EDF3FC" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastMessagePreview}" FontSize="10" Foreground="#9AA7BA" TextTrimming="CharacterEllipsis" MaxHeight="16" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#F21D45" CornerRadius="8" Padding="5,2" VerticalAlignment="Center">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding UnreadCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="{Binding UnreadCount}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    <ListBox x:Name="ContactsList" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedAddressBookContact, Mode=TwoWay}" SelectionChanged="ContactList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Padding="0" Margin="0,62,0,0" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             automation:AutomationProperties.AutomationId="ContactsList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ContactSurface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ContactSurface" Property="Background" Value="#39243D"/><Setter TargetName="ContactSurface" Property="BorderBrush" Value="#F21D45"/><Setter TargetName="ContactSurface" Property="BorderThickness" Value="3,0,0,0"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ContactSurface" Property="Background" Value="#39243D"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="38" Height="38" VerticalAlignment="Center" MouseLeftButtonUp="ContactAvatar_Click">
                                        <Grid.Style><Style TargetType="Grid"><Setter Property="Cursor" Value="Arrow"/><Setter Property="ToolTip" Value="Aucun statut disponible"/><Style.Triggers><DataTrigger Binding="{Binding HasReceivedStatus}" Value="True"><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="Voir les statuts de ce contact"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                        <Border CornerRadius="19" Background="#263D5B" BorderBrush="#42658F" BorderThickness="1">
                                            <TextBlock Text="{Binding AvatarInitials}" FontSize="11" FontWeight="Bold" Foreground="#E6EEF9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding RemoteAvatarBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding RemoteAvatarBytes}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" ClipToBounds="True">
                                            <Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip>
                                            <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding AvatarPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                        </Image>
                                        <Border CornerRadius="21" BorderBrush="#55D6A5" BorderThickness="2" Margin="-2">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasReceivedStatus}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,4,0">
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#EDF3FC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PeerId}" FontSize="8" Foreground="#9AA7BA" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="✓" Foreground="#55D6A5" FontSize="13" VerticalAlignment="Center" ToolTip="Identité vérifiée">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVerified}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="SelfStatusCard" VerticalAlignment="Top" Margin="0,0,0,8" Padding="8,7"
                            Background="#B50A0D14" BorderBrush="#263A55" BorderThickness="1" CornerRadius="12"
                            Visibility="Collapsed" MouseLeftButtonUp="OpenSelfConversation_Click"
                            Cursor="Hand" ToolTip="Ouvrir la conversation avec vous-même">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="38" Height="38" VerticalAlignment="Center" Cursor="Hand"
                                  MouseLeftButtonUp="ContactAvatar_Click" ToolTip="Voir mes statuts">
                                <Border CornerRadius="19" Background="#263D5B" BorderBrush="#42658F" BorderThickness="1">
                                    <TextBlock Text="Vous" FontSize="9" FontWeight="Bold" Foreground="#E6EEF9"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding AvatarBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                       Stretch="UniformToFill">
                                    <Image.Clip><EllipseGeometry Center="19,19" RadiusX="17" RadiusY="17"/></Image.Clip>
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvatarBytes}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,4,0">
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#EDF3FC" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Cliquer pour discuter · (vous)" FontSize="10" Foreground="#9AA7BA"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="ConversationEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="17" CornerRadius="16" Background="#142238" BorderBrush="#263A55" BorderThickness="1" MaxWidth="240">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conversations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="✦" FontSize="22" Foreground="#FF4968" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Tout est calme ici" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Connectez un ami du réseau local pour démarrer votre première conversation." FontSize="10" Foreground="#A7B1C2" TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ContactsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18" CornerRadius="16" Background="#142238" BorderBrush="#263A55" BorderThickness="1" MaxWidth="240" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="♧" FontSize="24" Foreground="#FF4968" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Votre cercle RedChat" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vos contacts apparaîtront ici après une première connexion sécurisée sur le réseau local." FontSize="10" Foreground="#A7B1C2" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Expander Grid.Row="5" Header="CONNEXION DIRECTE / PAIRS" Foreground="#91A7C6" FontSize="9" Margin="0,8,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <TextBox Text="{Binding ConnectEndpoint, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" FontSize="10" ToolTip="IP locale:port" automation:AutomationProperties.AutomationId="ConnectEndpoint" />
                        <Button Content="Se connecter à l'adresse" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" FontSize="10" Padding="8,5" />
                        <TextBlock Text="{Binding ConnectionNotice}" Foreground="#55D6A5" FontSize="9" Margin="2,3" />
                        <ItemsControl ItemsSource="{Binding DiscoveredPeers}" MaxHeight="90">
                            <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="1,3"><Button DockPanel.Dock="Right" Content="Utiliser" Padding="5,2" FontSize="9" Click="UseDiscoveredPeer_Click"/><TextBlock Text="{Binding Endpoint}" Foreground="#91A7C6" FontSize="9" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <!-- Conversation active -->
        <Border Grid.Row="1" Grid.Column="2" Background="#78070A10" BorderBrush="#263A55" BorderThickness="0,0,1,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#C90B1422" BorderBrush="#263A55" BorderThickness="0,0,0,1" Padding="22,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" VerticalAlignment="Center"><Border CornerRadius="22" Background="{StaticResource AccentGradient}" BorderBrush="#FF7890" BorderThickness="2"><TextBlock Text="{Binding SelectedConversation.AvatarInitials, FallbackValue=RC, TargetNullValue=RC}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Image Source="{Binding SelectedConversation.RemoteAvatarBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="22,22" RadiusX="21" RadiusY="21"/></Image.Clip><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedConversation.RemoteAvatarBytes}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><Image Source="{Binding SelectedConversation.AvatarPath}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="22,22" RadiusX="21" RadiusY="21"/></Image.Clip><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedConversation.AvatarPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedConversation.AvatarPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding SelectedConversation.DisplayName, TargetNullValue='Bienvenue sur RedChat'}" FontSize="15" FontWeight="SemiBold" Foreground="#F2F6FD" />
                            <TextBlock Text="{Binding SelectedConversation.TypingLabel, TargetNullValue='Messagerie privée'}" Foreground="#8299B9" FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Boutons d'appel : liés au CallViewModel (état, activation et visibilité décidés dans le ViewModel, aucune boîte de dialogue). -->
                            <Button x:Name="CallButton" Style="{StaticResource CallIconButton}" Content="&#xE717;" automation:AutomationProperties.Name="Appel audio" ToolTip="Démarrer un appel audio avec ce contact" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="12000" Command="{Binding Call.StartAudioCommand}" automation:AutomationProperties.AutomationId="CallButton" />
                            <Button x:Name="VideoCallButton" Style="{StaticResource CallIconButton}" Content="&#xE714;" automation:AutomationProperties.Name="Appel vidéo" ToolTip="Démarrer un appel vidéo avec ce contact" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="12000" Command="{Binding Call.StartVideoCommand}" automation:AutomationProperties.AutomationId="VideoCallButton" />
                            <Button x:Name="MicrophoneButton" Style="{StaticResource CallMicrophoneButton}" Content="&#xE720;" automation:AutomationProperties.Name="Microphone" ToolTip="{Binding Call.MicrophoneToolTip}" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="12000" Command="{Binding Call.ToggleMicrophoneCommand}" Visibility="{Binding Call.IsInCall, Converter={StaticResource BoolToVisibility}}" automation:AutomationProperties.AutomationId="ToggleMicrophoneButton" />
                            <Button x:Name="CameraButton" Style="{StaticResource CallCameraButton}" Content="&#xE722;" automation:AutomationProperties.Name="Caméra" ToolTip="{Binding Call.CameraToolTip}" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="12000" Command="{Binding Call.ToggleCameraCommand}" Visibility="{Binding Call.IsVideoCall, Converter={StaticResource BoolToVisibility}}" automation:AutomationProperties.AutomationId="ToggleCameraButton" />
                            <Button x:Name="HangupButton" Style="{StaticResource CallHangupButton}" Content="&#xE711;" automation:AutomationProperties.Name="Raccrocher" ToolTip="Terminer ou annuler l’appel en cours" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="12000" Command="{Binding Call.HangupCommand}" Visibility="{Binding Call.IsCallActive, Converter={StaticResource BoolToVisibility}}" automation:AutomationProperties.AutomationId="HangupCallButton" />
                            <Button x:Name="FavoriteConversationButton" Style="{StaticResource RoundActionButton}" Content="☆" ToolTip="Ajouter aux favoris" Click="ToggleFavorite_Click" automation:AutomationProperties.AutomationId="FavoriteConversationButton" />
                            <Button Style="{StaticResource RoundActionButton}" Content="🖼" Click="SetConversationWallpaper_Click" ToolTip="Choisir le fond d’écran de cette conversation" automation:AutomationProperties.AutomationId="SetConversationWallpaperButton" />
                            <Button Content="×" Click="RemoveConversationWallpaper_Click" ToolTip="Retirer le fond d’écran personnalisé">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RoundActionButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.HasWallpaper}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource RoundActionButton}" Content="＋" Click="CreateGroup_Click" ToolTip="Créer un groupe" />
                            <Button Style="{StaticResource RoundActionButton}" Content="🗑" Click="RemoveConversation_Click" ToolTip="Supprimer cette discussion ou ce groupe" automation:AutomationProperties.AutomationId="RemoveConversationButton" />
                            <Button Style="{StaticResource RoundActionButton}" Content="⋮" Click="ToggleDetails_Click" ToolTip="Afficher / masquer les détails du contact" automation:AutomationProperties.AutomationId="ToggleDetailsButton" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="16,8,16,0">
                    <!-- Bandeau d'appel non modal : état, erreur média, Accepter/Refuser pour un appel entrant. -->
                    <Border Visibility="{Binding Call.IsBannerVisible, Converter={StaticResource BoolToVisibility}}" Background="#1C2B40" BorderBrush="#263A55" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" automation:AutomationProperties.AutomationId="CallBanner">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Masquer" Command="{Binding Call.DismissNoticeCommand}" Style="{StaticResource MessageActionButton}" VerticalAlignment="Top" automation:AutomationProperties.AutomationId="DismissCallNoticeButton" />
                            <StackPanel>
                                <TextBlock Text="{Binding Call.StatusText}" Foreground="#F2F6FD" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Call.ErrorText}" Foreground="#FF8799" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Call.IsIncomingRinging, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Accepter" Command="{Binding Call.AcceptCommand}" Style="{StaticResource PrimaryButton}" Padding="14,5" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="AcceptCallButton" />
                                    <Button Content="Refuser" Command="{Binding Call.RejectCommand}" Padding="14,5" automation:AutomationProperties.AutomationId="RejectCallButton" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding StartupNotice}" Foreground="#F4C66A" FontSize="10" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding SaveWarning}" Foreground="#F4C66A" FontSize="10" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding AttachmentNotice}" Foreground="#55D6A5" FontSize="9"
                               Margin="0,0,0,3" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Border Background="#172333" BorderBrush="#2A3D55" BorderThickness="1" CornerRadius="8"
                            Padding="7" Margin="0,0,0,4"
                            Visibility="{Binding HasReceivedAttachments, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Médias reçus" Foreground="#DCE8F5" FontSize="10"
                                       FontWeight="SemiBold" Margin="2,0,0,4" />
                            <ItemsControl ItemsSource="{Binding ReceivedAttachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="1,2">
                                            <Button DockPanel.Dock="Right" Content="Ouvrir" Click="OpenReceivedAttachment_Click"
                                                    Padding="9,3" Margin="6,0,0,0" FontSize="9" />
                                            <TextBlock Text="{Binding FileName}" Foreground="#B9C9DC" FontSize="9"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text=" · Vue unique" Foreground="#FF9BAC" FontSize="9"
                                                       VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsViewOnce}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="#172333" BorderBrush="#2A3D55" BorderThickness="1" CornerRadius="8"
                            Padding="7" Margin="0,0,0,4"
                            Visibility="{Binding HasVoiceMessages, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Historique des messages vocaux" Foreground="#DCE8F5"
                                       FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4" />
                            <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding VoiceMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="1,2" LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="▶ Écouter"
                                                        Click="PlayVoice_Click" Padding="9,3" Margin="6,0,0,0"
                                                        FontSize="9" ToolTip="Réécouter ce message vocal"
                                                        automation:AutomationProperties.AutomationId="PlayArchivedVoiceButton" />
                                                <TextBlock Text="{Binding DisplayLabel}" Foreground="#B9C9DC"
                                                           FontSize="9" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Error}" Foreground="#FF8799" FontSize="10" Margin="0,0,0,3" />
                </StackPanel>
                <Grid Grid.Row="2" Background="#78070A10">
                    <Image Source="{Binding SelectedConversation.WallpaperPath}" Stretch="UniformToFill"
                           Opacity="0.55" IsHitTestVisible="False" />
                    <Border Background="#78070A10" IsHitTestVisible="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding SelectedConversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,6">
                                        <Border CornerRadius="16" Padding="15,11" MaxWidth="680" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#263D5B" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter Property="Background" Value="#A51C3B"/><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ViewOnceLabel}" FontSize="12" Foreground="#F3F6FC">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsViewOnce}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#F3F6FC">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsViewOnce}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DockPanel LastChildFill="False" HorizontalAlignment="Right" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding SentAtUnixMs, Converter={StaticResource UnixTimeConverter}}" FontSize="9" Foreground="#C2CDE0" />
                                                    <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#C2CDE0" Margin="7,0,0,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Text="Modifié" FontSize="8" Foreground="#C2CDE0" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEdited}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Afficher une fois" Style="{StaticResource MessageActionButton}"
                                                Click="ViewOnceMessage_Click" CommandParameter="{Binding}"
                                                Visibility="{Binding CanOpenViewOnce, Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Left" Margin="3,1,3,0" />
                                        <WrapPanel HorizontalAlignment="Left" Margin="3,1,3,0">
                                            <Button Content="Répondre" Style="{StaticResource MessageActionButton}" Command="{Binding DataContext.SelectedConversation.ReplyCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                            <Button Content="👍" Style="{StaticResource MessageActionButton}" Command="{Binding DataContext.SelectedConversation.LikeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Id}" />
                                            <Button Content="Modifier" Command="{Binding DataContext.SelectedConversation.BeginEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MessageActionButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Button Content="Supprimer" Command="{Binding DataContext.SelectedConversation.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Id}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MessageActionButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" Padding="34" CornerRadius="26" Background="#C90B1422" BorderBrush="#263A55" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedConversation}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="26" Background="#48243B" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Viewbox Width="44" Height="34" Stretch="Uniform">
                                    <Canvas Width="52" Height="34">
                                        <Path Fill="#F21D45" Data="M 7,23 C 10,12 20,5 32,6 C 39,7 44,12 46,18 C 39,16 31,17 24,20 C 17,23 12,25 7,23 Z" />
                                        <Path Fill="#FF7890" Data="M 4,24 C 12,25 19,22 26,19 C 34,16 42,16 49,19 C 45,24 35,27 25,28 C 15,29 7,28 4,24 Z" />
                                        <Path Fill="#A90E2C" Data="M 8,29 C 19,31 35,29 45,25 C 41,31 27,34 15,32 C 12,32 9,31 8,29 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Votre espace de discussion" FontSize="21" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Choisissez une conversation ou connectez-vous à un pair de votre réseau local pour commencer à échanger." FontSize="12" Foreground="#A7B1C2" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                            <Border Background="#263D5B" CornerRadius="14" Padding="13,9" Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="●" Foreground="#55D6A5" Margin="0,0,8,0" />
                                    <TextBlock Text="Vos échanges restent sur votre réseau local" FontSize="10" Foreground="#C3D1E4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="3" Background="#C90B1422" Padding="20,14,20,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedConversation}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                    <Border Background="#48243B" CornerRadius="12" Padding="11" Margin="0,0,0,9">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedConversation.ReplyToId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <DockPanel>
                            <TextBlock Text="{Binding SelectedConversation.ReplyToId, StringFormat='Réponse au message : {0}'}" Foreground="#AFCBFF" FontSize="10" VerticalAlignment="Center" />
                            <Button Content="×" DockPanel.Dock="Right" Padding="4,0" Margin="0" Command="{Binding SelectedConversation.CancelReplyCommand}" />
                        </DockPanel>
                    </Border>
                    <DockPanel x:Name="EditMessagePanel" Margin="0,0,0,9">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedConversation.EditingMessageId}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedConversation.EditingMessageId}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <Button Content="Valider" DockPanel.Dock="Right" Command="{Binding SelectedConversation.SaveEditCommand}" Margin="5,0,0,0" Padding="9,5" />
                        <TextBox Text="{Binding SelectedConversation.EditDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="8192" MinHeight="32" FontSize="11" />
                        <Button Content="Annuler" DockPanel.Dock="Right" Command="{Binding SelectedConversation.CancelEditCommand}" Margin="5,0,0,0" Padding="8,5" />
                    </DockPanel>
                    <Border Background="#D90B1018" BorderBrush="#263A55" BorderThickness="1" CornerRadius="24" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📎" Style="{StaticResource RoundActionButton}" Width="38" Height="38" Margin="0,0,4,0" Click="Attachment_Click" ToolTip="Joindre un fichier" automation:AutomationProperties.AutomationId="AttachFileButton" />
                            <Button Grid.Column="1" Content="🎙" Style="{StaticResource RoundActionButton}" Width="38" Height="38" Margin="0,0,4,0" Click="VoiceRecord_Click" ToolTip="Enregistrer / terminer un message vocal" automation:AutomationProperties.AutomationId="VoiceRecordButton" />
                            <Button Grid.Column="2" Content="▶" Style="{StaticResource RoundActionButton}" Width="38" Height="38" Margin="0,0,4,0" Click="PlayVoice_Click" IsEnabled="{Binding HasVoiceMessages}" ToolTip="Lire le vocal le plus récent" automation:AutomationProperties.AutomationId="PlayVoiceButton" />
                            <Button x:Name="StickerButton" Grid.Column="3" Content="▣" Style="{StaticResource RoundActionButton}" Width="38" Height="38" Margin="0,0,4,0" Click="StickerPicker_Click" ToolTip="Envoyer un sticker expressif" automation:AutomationProperties.AutomationId="StickerPickerButton" />
                            <Button x:Name="EmojiButton" Grid.Column="4" Content="😊" Style="{StaticResource RoundActionButton}" Width="38" Height="38" Margin="0,0,4,0" Click="EmojiPicker_Click" ToolTip="Insérer un emoji" automation:AutomationProperties.AutomationId="EmojiPickerButton" />
                            <ToggleButton Grid.Column="5" Content="1" Width="34" Height="34" Margin="2,0"
                                          IsChecked="{Binding SelectedConversation.IsViewOnceMode}"
                                          IsEnabled="{Binding SelectedConversation.CanUseViewOnce}"
                                          ToolTip="Envoyer le prochain texte ou média en vue unique"
                                          automation:AutomationProperties.AutomationId="ViewOnceToggle" />
                            <TextBox Grid.Column="6" Text="{Binding SelectedConversation.Draft, UpdateSourceTrigger=PropertyChanged}" TextChanged="Draft_TextChanged" MaxLength="8192" AcceptsReturn="True" MaxHeight="90" MinHeight="34" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="7,8" FontSize="12" ToolTip="Écrire un message…" automation:AutomationProperties.AutomationId="MessageDraft" />
                            <Button Grid.Column="7" Content="➤" Style="{StaticResource PrimaryButton}" Width="42" Height="42" Padding="0" Margin="3,0,0,0" FontSize="19" IsDefault="True" Command="{Binding SelectedConversation.SendCommand}" ToolTip="Envoyer le message" automation:AutomationProperties.AutomationId="SendMessageButton" />
                        </Grid>
                    </Border>
                    <Popup x:Name="StickerPickerPopup" Placement="Top" PlacementTarget="{Binding ElementName=StickerButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="12" Padding="10" Width="300">
                            <StackPanel>
                                <TextBlock Text="STICKERS EXPRESSIFS" Foreground="{StaticResource PrimaryText}" FontWeight="Bold" Margin="2,0,0,8" />
                                <UniformGrid Columns="4">
                                    <Button Content="🥳" FontSize="30" Click="Sticker_Click" Tag="🥳" ToolTip="Fête"/><Button Content="😍" FontSize="30" Click="Sticker_Click" Tag="😍" ToolTip="Amour"/><Button Content="😂" FontSize="30" Click="Sticker_Click" Tag="😂" ToolTip="Rire"/><Button Content="😎" FontSize="30" Click="Sticker_Click" Tag="😎" ToolTip="Cool"/>
                                    <Button Content="🤗" FontSize="30" Click="Sticker_Click" Tag="🤗" ToolTip="Câlin"/><Button Content="😭" FontSize="30" Click="Sticker_Click" Tag="😭" ToolTip="Émotion"/><Button Content="🔥" FontSize="30" Click="Sticker_Click" Tag="🔥" ToolTip="Feu"/><Button Content="❤️" FontSize="30" Click="Sticker_Click" Tag="❤️" ToolTip="Cœur"/>
                                    <Button Content="🙏" FontSize="30" Click="Sticker_Click" Tag="🙏" ToolTip="Merci"/><Button Content="💯" FontSize="30" Click="Sticker_Click" Tag="💯" ToolTip="Parfait"/><Button Content="🤩" FontSize="30" Click="Sticker_Click" Tag="🤩" ToolTip="Waouh"/><Button Content="👑" FontSize="30" Click="Sticker_Click" Tag="👑" ToolTip="Roi"/>
                                </UniformGrid>
                                <TextBlock Text="Stickers expressifs envoyés comme messages Unicode. Les packs d'images personnalisés seront ajoutés avec le transfert média dédié." Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="2,8,2,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="EmojiPickerPopup" Placement="Top" PlacementTarget="{Binding ElementName=EmojiButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="12" Padding="10" Width="300">
                            <StackPanel>
                                <TextBlock Text="ÉMOJIS" Foreground="{StaticResource PrimaryText}" FontWeight="Bold" Margin="2,0,0,8" />
                                <UniformGrid Columns="8">
                                    <Button Content="😀" Click="Emoji_Click" Tag="😀"/><Button Content="😂" Click="Emoji_Click" Tag="😂"/><Button Content="🥰" Click="Emoji_Click" Tag="🥰"/><Button Content="😍" Click="Emoji_Click" Tag="😍"/>
                                    <Button Content="😎" Click="Emoji_Click" Tag="😎"/><Button Content="😭" Click="Emoji_Click" Tag="😭"/><Button Content="😡" Click="Emoji_Click" Tag="😡"/><Button Content="🤔" Click="Emoji_Click" Tag="🤔"/>
                                    <Button Content="👍" Click="Emoji_Click" Tag="👍"/><Button Content="❤️" Click="Emoji_Click" Tag="❤️"/><Button Content="🔥" Click="Emoji_Click" Tag="🔥"/><Button Content="🎉" Click="Emoji_Click" Tag="🎉"/>
                                    <Button Content="🙏" Click="Emoji_Click" Tag="🙏"/><Button Content="👏" Click="Emoji_Click" Tag="👏"/><Button Content="💯" Click="Emoji_Click" Tag="💯"/><Button Content="✨" Click="Emoji_Click" Tag="✨"/>
                                    <Button Content="🌹" Click="Emoji_Click" Tag="🌹"/><Button Content="💔" Click="Emoji_Click" Tag="💔"/><Button Content="🥳" Click="Emoji_Click" Tag="🥳"/><Button Content="🤝" Click="Emoji_Click" Tag="🤝"/>
                                    <Button Content="🐱" Click="Emoji_Click" Tag="🐱"/><Button Content="🐶" Click="Emoji_Click" Tag="🐶"/><Button Content="⚽" Click="Emoji_Click" Tag="⚽"/><Button Content="🎮" Click="Emoji_Click" Tag="🎮"/>
                                </UniformGrid>
                                <TextBlock Text="Les emojis sont envoyés comme texte Unicode et restent compatibles avec le protocole actuel." Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="2,8,2,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <TextBlock Text="Chiffrement de bout en bout · Réseau local" Foreground="#98A7BC" FontSize="9" HorizontalAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Panneau de détails du contact : affiché/masqué depuis le menu ⋮ -->
        <Border x:Name="ContactDetailsPanel" Grid.Row="1" Grid.Column="3" Background="#C90B1422" BorderBrush="#263A55" BorderThickness="0,0,1,1" Padding="18" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DÉTAILS DU CONTACT" FontSize="10" FontWeight="Bold" Foreground="#8EA3C2" Margin="0,0,0,16" />
                    <Grid Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Border CornerRadius="38" Background="#263D5B" BorderBrush="#F21D45" BorderThickness="2"><TextBlock Text="{Binding SelectedAddressBookContact.AvatarInitials, TargetNullValue='RC'}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Image Source="{Binding SelectedAddressBookContact.RemoteAvatarBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill">
                            <Image.Clip><EllipseGeometry Center="38,38" RadiusX="36" RadiusY="36"/></Image.Clip>
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedAddressBookContact.RemoteAvatarBytes}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedAddressBookContact.AvatarPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedAddressBookContact.AvatarPath}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Image Source="{Binding SelectedAddressBookContact.AvatarPath}" Stretch="UniformToFill">
                            <Image.Clip><EllipseGeometry Center="38,38" RadiusX="36" RadiusY="36"/></Image.Clip>
                            <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedAddressBookContact.AvatarPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedAddressBookContact.AvatarPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                        </Image>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button Content="Changer la photo" Click="ChangeAvatar_Click" FontSize="9" Padding="9,5" Margin="0,0,5,0" />
                        <Button Content="Retirer" Click="RemoveAvatar_Click" FontSize="9" Padding="9,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedAddressBookContact.DisplayLabel, TargetNullValue='Aucun contact sélectionné'}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.PeerId}" Foreground="#9AA7BA" FontSize="8" Margin="0,5,0,14" TextWrapping="Wrap" />
                    <TextBlock Text="Profil public" Foreground="#F21D45" FontSize="10" FontWeight="Bold" Margin="0,8,0,5" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.RemoteStatus}" Foreground="#E3E8F0" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.RemoteAbout}" Foreground="#B8C2D1" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,10" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.AvatarInitials}" Visibility="Collapsed"/>
                    <TextBlock Text="Nom local" Foreground="#8EA3C2" FontSize="10" />
                    <TextBox x:Name="ContactNameBox" Text="{Binding SelectedAddressBookContact.DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,5,0,5" FontSize="11" />
                    <Button Content="Enregistrer le nom" Click="SaveContactName_Click" Style="{StaticResource PrimaryButton}" FontSize="10" />
                    <TextBlock Text="Code de sécurité" Foreground="#8EA3C2" FontSize="10" Margin="0,18,0,5" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.SecurityCode}" FontSize="12" FontWeight="SemiBold" Foreground="#F5F7FB" TextWrapping="Wrap" />
                    <TextBlock Text="Comparez ce code avec votre contact par un autre canal." FontSize="9" Foreground="#9AA7BA" Margin="0,6,0,8" />
                    <Button Content="Basculer la vérification" Click="ToggleContactVerification_Click" FontSize="10" />
                    <Button Content="Supprimer ce contact" Click="RemoveContact_Click" Background="#7A1620" Foreground="White" BorderBrush="#FF4968" FontSize="10" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.IsVerified, StringFormat=Contact vérifié : {0}}" Foreground="#55D6A5" FontSize="10" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding SelectedAddressBookContact.Error}" Foreground="#FF8799" FontSize="10" Margin="0,7,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
